<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.sistema</groupId>
    <artifactId>contable</artifactId>
    <version>1.0-SNAPSHOT</version>


    <!-- GT1 MODULO COMPRAS NO TOCAR -->
    <!-- Define explícitamente el tipo de empaquetado del proyecto -->
    <packaging>jar</packaging>
    <!-- GT1 MODULO COMPRAS NO TOCAR -->

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- GT1 MODULO COMPRAS NO TOCAR -->
        <!-- Establece la codificación de archivos para evitar problemas con caracteres especiales -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- GT1 MODULO COMPRAS NO TOCAR -->

    </properties>

    <dependencies>
        <!-- GT1 MODULO COMPRAS NO TOCAR / PostgreSQL Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        <!-- GT1 MODULO COMPRAS NO TOCAR / PostgreSQL Driver -->
            
        </dependency>

        <!-- GT1 MODULO COMPRAS NO TOCAR / Apache POI: Biblioteca para manipular archivos de Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>

            
        </dependency>
        <!-- GT1 MODULO COMPRAS NO TOCAR / Apache POI OOXML: Soporte para formatos modernos de Excel (.xlsx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <!-- GT1 MODULO COMPRAS NO TOCAR / iTextPDF: Biblioteca para generar y manipular documentos PDF -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.4.4.Final</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.23.1</version>
        </dependency>
        
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
        </dependency>
    </dependencies>

    <!-- GT1 MODULO COMPRAS NO TOCAR -->
    <!-- Sección de configuración de plugins de compilación -->
    <build>
        <plugins>
            <!-- Plugin para controlar la compilación del código Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>